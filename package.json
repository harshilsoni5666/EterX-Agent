{
  "name": "eterx",
  "version": "0.1.24",
  "description": "EterX autonomous AI agent desktop application",
  "author": {
    "name": "Harshil Soni",
    "email": "harshilsoni5666@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/harshilsoni5666/EterX-Agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshilsoni5666/EterX-Agent.git"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "electron/main.js",
  "bin": {
    "eterx": "./eterx.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.46.0",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@slack/bolt": "^4.7.2",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.15.1",
    "@tanstack/react-virtual": "^3.13.23",
    "@tavily/core": "^0.7.2",
    "@types/three": "^0.183.1",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "d3-color": "^3.1.0",
    "d3-scale": "^4.0.2",
    "docx": "^8.5.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.18.2",
    "fs-extra": "^11.3.4",
    "geist": "^1.7.2",
    "googlethis": "^1.8.0",
    "groq-sdk": "^1.1.2",
    "gsap": "^3.15.0",
    "imapflow": "^1.2.3",
    "katex": "^0.16.44",
    "koffi": "^2.15.2",
    "lucide-react": "^0.364.0",
    "mailparser": "^3.7.4",
    "mathjs": "^12.4.3",
    "mermaid": "^11.15.0",
    "nanoid": "^5.1.7",
    "next": "14.1.4",
    "nodemailer": "^8.0.4",
    "openai": "^6.33.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^1.1.4",
    "playwright-core": "^1.58.2",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "react-simple-maps": "^3.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
