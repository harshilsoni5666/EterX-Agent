  "scripts": {
    "dev": "next dev --webpack",
    "desktop": "npm run desktop:prepare-whisper && node scripts/run-desktop-dev.mjs",
    "desktop:prepare-whisper": "node scripts/prepare-whisper-runtime.mjs",
    "desktop:prepare-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:build": "npm run desktop:prepare-whisper && npm run build && npm run desktop:prepare-runtime && electron-builder",
    "desktop:build:win": "cross-env ETERX_RUNTIME_TARGETS=win32:x64,win32:arm64 npm run desktop:prepare-whisper && npm run build && cross-env ETERX_RUNTIME_TARGETS=win32:x64,win32:arm64 npm run desktop:prepare-runtime && electron-builder --win --x64 --arm64",
    "desktop:build:linux": "cross-env ETERX_RUNTIME_TARGETS=linux:x64,linux:arm64 npm run desktop:prepare-whisper && npm run build && cross-env ETERX_RUNTIME_TARGETS=linux:x64,linux:arm64 npm run desktop:prepare-runtime && electron-builder --linux --x64 --arm64",
    "desktop:build:mac": "cross-env ETERX_RUNTIME_TARGETS=darwin:x64,darwin:arm64 npm run desktop:prepare-whisper && npm run build && cross-env ETERX_RUNTIME_TARGETS=darwin:x64,darwin:arm64 npm run desktop:prepare-runtime && electron-builder --mac --x64 --arm64",
    "build": "node scripts/build-production.mjs",
    "check:release-config": "node scripts/check-release-config.mjs",
    "start": "next start",
    "test": "npm run test:ci",
    "test:ci": "npm run test:reference-evals && npm run test:markdown-renderer && npm run test:path-utils && npm run test:platform-shortcuts && npm run test:file-icon-utils && npm run test:model-selector && npm run test:title-generation && npm run test:api-retry && npm run test:live-provider && npm run test:nova-sonic && npm run test:credential-storage && npm run test:connector-storage && npm run test:workspace-tools && npm run test:terminal-output-policy && npm run test:execution-governor && npm run test:adaptive-harness && npm run test:context-fabric && npm run test:agent-cache && npm run test:request-token-budget && npm run test:context-resonance && npm run test:context-compaction-policy && npm run test:context-scope && npm run test:agent-lifecycle && npm run test:tool-schema-router && npm run test:skill-routing && npm run test:parallel-key-pool && npm run test:polling-coordinator && npm run test:search-runtime && npm run test:image-runtime && npm run test:video-runtime && npm run test:external-service-check && npm run test:sub-agent-runtime && npm run test:chat-feed-lifecycle && npm run test:chat-store-recovery && npm run test:chat-send-lifecycle && npm run test:chat-media-store && npm run test:chat-agent-selection && npm run test:thought-stream-lifecycle && npm run test:trace-visibility && npm run test:streaming-lifecycle && npm run test:terminal-live-trace && npm run test:scheduled-task-store && npm run test:agent-builder-quality && npm run test:provider-runtime && npm run test:local-openai-compat && tsx tests/agent-steering.integration.ts && tsx tests/chat-copy.integration.ts && tsx tests/chat-request-recovery.integration.ts && node tests/chat-window.integration.cjs && tsx tests/connector-runtime.integration.ts && node tests/gateway-telegram.integration.cjs && tsx tests/parallel-tool-calls.integration.ts && tsx tests/theme-startup.integration.ts",
    "test:reference-evals": "tsx scripts/run-reference-evals.ts",
    "test:markdown-renderer": "tsx tests/markdown-renderer.integration.tsx",
    "test:path-utils": "tsx tests/path-utils.integration.ts",
    "test:platform-shortcuts": "tsx tests/platform-shortcuts.integration.ts",
    "test:file-icon-utils": "tsx tests/file-icon-utils.integration.ts",
    "test:model-selector": "tsx tests/model-selector-store.integration.ts",
    "test:title-generation": "tsx tests/title-generation.integration.ts",
    "test:api-retry": "tsx tests/api-retry.integration.ts",
    "test:live-provider": "tsx tests/live-provider.integration.ts",
    "test:nova-sonic": "tsx tests/nova-sonic-contract.integration.ts",
    "test:credential-storage": "tsx tests/credential-storage-coverage.integration.ts",
    "test:connector-storage": "tsx tests/connector-storage.integration.ts",
    "test:workspace-tools": "tsx tests/workspace-edit-contract.integration.ts",
    "test:terminal-output-policy": "tsx tests/terminal-output-policy.integration.ts",
    "test:execution-governor": "tsx tests/execution-governor.integration.ts",
    "test:adaptive-harness": "tsx tests/adaptive-harness.integration.ts",
    "test:context-fabric": "tsx tests/context-fabric.integration.ts",
    "test:agent-cache": "tsx tests/agent-cache.integration.ts",
    "test:request-token-budget": "tsx tests/request-token-budget.integration.ts",
    "test:context-resonance": "tsx tests/context-resonance.integration.ts",
    "test:context-compaction-policy": "tsx tests/context-compaction-policy.integration.ts",
    "test:agent-lifecycle": "tsx tests/agent-lifecycle.integration.ts",
    "test:tool-schema-router": "tsx tests/tool-schema-router.integration.ts",
    "test:skill-routing": "tsx tests/skill-routing.integration.ts",
    "test:context-scope": "tsx tests/context-scope.integration.ts",
    "test:parallel-key-pool": "tsx tests/parallel-key-pool.integration.ts",
    "test:polling-coordinator": "tsx tests/polling-coordinator.integration.ts",
    "test:search-runtime": "tsx tests/search-runtime.integration.ts",
    "test:image-runtime": "tsx tests/image-generation-runtime.integration.ts",
    "test:video-runtime": "tsx tests/video-generation-runtime.integration.ts",
    "test:external-service-check": "tsx tests/external-service-check.integration.ts",
    "test:sub-agent-runtime": "tsx tests/sub-agent-runtime.integration.ts",
    "test:chat-feed-lifecycle": "tsx tests/chat-feed-lifecycle.integration.ts",
    "test:chat-store-recovery": "tsx tests/chat-store-recovery.integration.ts",
    "test:chat-send-lifecycle": "tsx tests/chat-send-lifecycle.integration.ts",
    "test:chat-media-store": "tsx tests/chat-media-store.integration.ts",
    "test:chat-agent-selection": "tsx tests/chat-agent-selection.integration.ts && tsx tests/chat-composer-ownership.integration.ts",
    "test:chat-composer-ownership": "tsx tests/chat-composer-ownership.integration.ts",
    "test:thought-stream-lifecycle": "tsx tests/thought-stream-lifecycle.integration.ts",
    "test:trace-visibility": "tsx tests/trace-visibility.integration.ts",
    "test:streaming-lifecycle": "tsx tests/streaming-lifecycle.integration.ts",
    "test:terminal-live-trace": "tsx tests/terminal-live-trace.integration.ts",
    "test:scheduled-task-store": "tsx tests/scheduled-task-store.integration.ts",
    "test:agent-builder-quality": "tsx tests/agent-builder-quality.integration.ts",
    "test:provider-runtime": "tsx tests/provider-runtime.integration.ts && tsx tests/model-catalog-pagination.integration.ts && tsx tests/provider-cache-contract.integration.ts && tsx tests/gemini-stream-recovery.integration.ts",
    "test:local-openai-compat": "tsx tests/local-openai-compat.integration.ts",
    "benchmark:context-resonance": "tsx scripts/run-context-resonance-benchmark.ts",
    "test:gaia": "tsx scripts/run-gaia.ts",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.eterx.agent",
    "productName": "EterX",
    "directories": {
      "buildResources": "public"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "harshilsoni5666",
        "repo": "EterX-Agent",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "runtime/assets/native/**/*"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "electron/*.js",
      "electron/whisper-models.json",
      "electron/whisper-languages.json",
      "electron/splash.html",
      "electron/splash.css",
      "package.json",
      {
        "from": "desktop-runtime",
        "to": "runtime",
        "filter": [
          "server.js",
          "server-launcher.js",
          "package.json",
          "eterx-runtime.json",
          ".next/**/*",
          "public/**/*",
          "assets/**/*",
          "!assets/native/whisper/**/*",
          "!**/*.map",
          "!.next/cache/**/*",
          "!**/.env*",
          "!**/.DS_Store",
          "!**/Thumbs.db"
        ]
      },
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-runtime/assets/native/whisper",
        "to": "runtime/assets/native/whisper",
        "filter": [
          "**/*",
          "!models{,/**/*}"
        ]
      },
      {
        "from": "desktop-runtime/assets/native/whisper/models/ggml-large-v3-q5_0.bin",
        "to": "runtime/assets/native/whisper/models/ggml-large-v3-q5_0.bin"
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/logo.png",
        "to": "logo.png"
      },
      {
        "from": "desktop-runtime/dependencies.asar",
        "to": "runtime/dependencies.asar"
      },
      {
        "from": "desktop-runtime/dependencies.asar.unpacked",
        "to": "runtime/dependencies.asar.unpacked"
      },
      {
        "from": "desktop-runtime/terminal",
        "to": "runtime/terminal",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "executableName": "EterX",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "buildUniversalInstaller": false,
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EterX",
      "uninstallDisplayName": "EterX ${version}",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "public/logo.png",
      "executableName": "eterx"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "setup/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EterX uses the microphone only while you enable local voice dictation or Live Agent.",
        "NSCameraUsageDescription": "EterX uses the camera only when you enable camera sharing in Live Agent.",
        "NSScreenCaptureUsageDescription": "EterX captures the screen only while you explicitly enable screen sharing in Live Agent."
      },
      "entitlementsInherit": "setup/entitlements.mac.plist"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "electron": "^45.2.1",
    "electron-builder": "26.18.0",
    "electron-reloader": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  }
}
