    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.12"
  },
  "scripts": {
    "dev": "next dev",
    "desktop": "concurrently -k \"npm run dev\" \"electron .\"",
    "desktop:prepare-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare-runtime && electron-builder",
    "desktop:build:win": "cross-env ETERX_RUNTIME_TARGETS=win32:x64,win32:arm64 npm run build && cross-env ETERX_RUNTIME_TARGETS=win32:x64,win32:arm64 npm run desktop:prepare-runtime && electron-builder --win --x64 --arm64",
    "desktop:build:linux": "cross-env ETERX_RUNTIME_TARGETS=linux:x64,linux:arm64 npm run build && cross-env ETERX_RUNTIME_TARGETS=linux:x64,linux:arm64 npm run desktop:prepare-runtime && electron-builder --linux --x64 --arm64",
    "desktop:build:mac": "cross-env ETERX_RUNTIME_TARGETS=darwin:x64,darwin:arm64 npm run build && cross-env ETERX_RUNTIME_TARGETS=darwin:x64,darwin:arm64 npm run desktop:prepare-runtime && electron-builder --mac --x64 --arm64",
    "build": "node scripts/build-production.mjs",
    "start": "next start",
    "test": "npm run test:ci",
    "test:ci": "npm run test:reference-evals && npm run test:markdown-renderer && npm run test:path-utils && npm run test:platform-shortcuts && npm run test:file-icon-utils && npm run test:model-selector && npm run test:credential-storage && npm run test:connector-storage && npm run test:workspace-tools && npm run test:execution-governor && npm run test:adaptive-harness && npm run test:context-fabric && npm run test:agent-cache && npm run test:context-resonance && npm run test:context-compaction-policy && npm run test:context-scope && npm run test:agent-lifecycle && npm run test:tool-schema-router && npm run test:parallel-key-pool && npm run test:polling-coordinator && npm run test:search-runtime && npm run test:image-runtime && npm run test:video-runtime && npm run test:chat-feed-lifecycle && npm run test:thought-stream-lifecycle && npm run test:streaming-lifecycle && npm run test:scheduled-task-store && npm run test:agent-builder-quality && npm run test:provider-runtime && npm run test:local-openai-compat && npx tsc --noEmit --pretty false",
    "test:reference-evals": "tsx scripts/run-reference-evals.ts",
    "test:markdown-renderer": "tsx tests/markdown-renderer.integration.tsx",
    "test:path-utils": "tsx tests/path-utils.integration.ts",
    "test:platform-shortcuts": "tsx tests/platform-shortcuts.integration.ts",
    "test:file-icon-utils": "tsx tests/file-icon-utils.integration.ts",
    "test:model-selector": "tsx tests/model-selector-store.integration.ts",
    "test:credential-storage": "tsx tests/credential-storage-coverage.integration.ts",
    "test:connector-storage": "tsx tests/connector-storage.integration.ts",
    "test:workspace-tools": "tsx tests/workspace-edit-contract.integration.ts",
    "test:execution-governor": "tsx tests/execution-governor.integration.ts",
    "test:adaptive-harness": "tsx tests/adaptive-harness.integration.ts",
    "test:context-fabric": "tsx tests/context-fabric.integration.ts",
    "test:agent-cache": "tsx tests/agent-cache.integration.ts",
    "test:context-resonance": "tsx tests/context-resonance.integration.ts",
    "test:context-compaction-policy": "tsx tests/context-compaction-policy.integration.ts",
    "test:agent-lifecycle": "tsx tests/agent-lifecycle.integration.ts",
    "test:tool-schema-router": "tsx tests/tool-schema-router.integration.ts",
    "test:context-scope": "tsx tests/context-scope.integration.ts",
    "test:parallel-key-pool": "tsx tests/parallel-key-pool.integration.ts",
    "test:polling-coordinator": "tsx tests/polling-coordinator.integration.ts",
    "test:search-runtime": "tsx tests/search-runtime.integration.ts",
    "test:image-runtime": "tsx tests/image-generation-runtime.integration.ts",
    "test:video-runtime": "tsx tests/video-generation-runtime.integration.ts",
    "test:chat-feed-lifecycle": "tsx tests/chat-feed-lifecycle.integration.ts",
    "test:thought-stream-lifecycle": "tsx tests/thought-stream-lifecycle.integration.ts",
    "test:streaming-lifecycle": "tsx tests/streaming-lifecycle.integration.ts",
    "test:scheduled-task-store": "tsx tests/scheduled-task-store.integration.ts",
    "test:agent-builder-quality": "tsx tests/agent-builder-quality.integration.ts",
    "test:provider-runtime": "tsx tests/provider-runtime.integration.ts",
    "test:local-openai-compat": "tsx tests/local-openai-compat.integration.ts",
    "benchmark:context-resonance": "tsx scripts/run-context-resonance-benchmark.ts",
    "test:gaia": "tsx scripts/run-gaia.ts",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.eterx.agent",
    "productName": "EterX",
    "directories": {
      "buildResources": "public"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "harshilsoni5666",
        "repo": "EterX-Agent",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "compression": "normal",
    "asar": true,
    "asarUnpack": [
      "runtime/assets/native/**/*"
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "electron/**/*",
      "src/lib/agent/gateways/**/*.cjs",
      "package.json",
      {
        "from": "desktop-runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!dependencies.asar",
          "!dependencies.asar.unpacked/**/*"
        ]
      },
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/logo.png",
        "to": "logo.png"
      },
      {
        "from": "public/logo-black.png",
        "to": "logo-black.png"
      },
      {
        "from": "public/logo-white.png",
        "to": "logo-white.png"
      },
      {
        "from": "desktop-runtime/dependencies.asar",
        "to": "runtime/dependencies.asar"
      },
      {
        "from": "desktop-runtime/dependencies.asar.unpacked",
        "to": "runtime/dependencies.asar.unpacked"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "executableName": "EterX",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EterX",
      "uninstallDisplayName": "EterX ${version}",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "public/logo-whitetheme.png",
      "executableName": "eterx",
      "desktop": {
        "Name": "EterX",
        "Comment": "Autonomous AI Agent",
        "Categories": "Development;Utility;"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlementsInherit": "setup/entitlements.mac.plist"
    }
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/fs-extra": "^11.0.4",
    "@types/mathjs": "^9.4.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.27",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "^30.0.8",
    "electron-builder": "^24.13.3",
    "electron-reloader": "^1.2.3",
    "eslint": "^8",
    "eslint-config-next": "14.1.4",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  }
}
