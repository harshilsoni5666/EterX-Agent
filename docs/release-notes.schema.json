{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EterX customer release highlights",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "summary", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "description": "Exactly matches package.json for this release." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "items"],
        "properties": {
          "kind": { "enum": ["new", "improved", "fixed", "security"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 160 },
                "description": { "type": "string", "maxLength": 2000 }
              }
            }
          }
        }
      }
    }
  }
}
